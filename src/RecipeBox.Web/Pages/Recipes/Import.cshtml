@page
@model RecipeBox.Web.Pages.Recipes.ImportModel
@{
    ViewData["Title"] = "Import a recipe";
}

<div class="recipe-form">
    <a asp-page="Index" class="text-decoration-none">&larr; My recipes</a>
    <h1 class="mt-2">Import from a website</h1>
    <p class="text-secondary">
        Paste a public recipe page URL. Recipe Box looks for recipe data or visible ingredient and instruction sections, then lets you review the result before saving.
    </p>

    <form method="post" asp-page-handler="Import" class="border rounded-3 p-3 mb-4">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <label asp-for="RecipeUrl" class="form-label"></label>
        <input asp-for="RecipeUrl" class="form-control" type="url" inputmode="url" autocomplete="url" />
        <span asp-validation-for="RecipeUrl" class="text-danger"></span>
        <div class="form-text">HTTP or HTTPS pages with recipe data or clearly labeled ingredient and instruction sections are supported; maximum page size is 2 MB.</div>
        <button type="submit" class="btn btn-primary mt-3">Find recipe</button>
    </form>

    @if (Model.IsReview)
    {
        <section aria-labelledby="review-heading">
            <h2 id="review-heading" class="h4">Review the imported recipe</h2>
            <p class="text-secondary">Website data may be incomplete or inaccurate. Check every field before saving.</p>
            <form method="post" asp-page-handler="Save">
                <partial name="_RecipeForm" for="Input" />
                <button type="submit" class="btn btn-primary">Save recipe</button>
                <a class="btn btn-outline-secondary" asp-page="Import">Start over</a>
            </form>
        </section>
    }
</div>
