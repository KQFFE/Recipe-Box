@page "{id:int}"
@model RecipeBox.Web.Pages.Recipes.EditModel
@{
    ViewData["Title"] = "Edit recipe";
}

<h1 class="mb-4">Edit recipe</h1>
<form method="post" enctype="multipart/form-data" class="recipe-form">
    <partial name="_RecipeForm" for="Input" />
    <partial name="_RecipeImageUpload" for="Input" />
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary">Save changes</button>
        <a class="btn btn-outline-secondary" asp-page="Details" asp-route-id="@Model.Id">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
