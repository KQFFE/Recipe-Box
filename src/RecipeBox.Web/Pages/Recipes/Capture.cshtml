@page
@model RecipeBox.Web.Pages.Recipes.CaptureModel
@{
    ViewData["Title"] = "Capture a recipe";
}

<div class="recipe-form">
    <a asp-page="Index" class="text-decoration-none">&larr; My recipes</a>
    <h1 class="mt-2">Capture from a photo</h1>
    <p class="text-secondary">
        Choose or take a clear photo of a recipe. Text is extracted on this server and the photo is not saved.
    </p>

    <form method="post" enctype="multipart/form-data" asp-page-handler="Extract" class="border rounded-3 p-3 mb-4">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <label for="photo" class="form-label">Recipe photo</label>
        <input id="photo" name="photo" type="file" class="form-control"
               accept="image/jpeg,image/png,image/webp" capture="environment" />
        <div class="form-text">JPEG, PNG, or WebP; maximum 10 MB. English and Swedish text are supported.</div>
        <button type="submit" class="btn btn-primary mt-3">Extract recipe text</button>
    </form>

    @if (Model.IsReview)
    {
        <section aria-labelledby="review-heading">
            <h2 id="review-heading" class="h4">Review the extracted recipe</h2>
            <p class="text-secondary">OCR can make mistakes. Check the title, ingredients, and every step before saving.</p>
            <form method="post" asp-page-handler="Save">
                <partial name="_RecipeForm" for="Input" />
                <button type="submit" class="btn btn-primary">Save recipe</button>
                <a class="btn btn-outline-secondary" asp-page="Capture">Start over</a>
            </form>
        </section>
    }
</div>
