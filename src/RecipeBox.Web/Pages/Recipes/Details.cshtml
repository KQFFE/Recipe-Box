@page "{id:int}"
@model RecipeBox.Web.Pages.Recipes.DetailsModel
@{
    ViewData["Title"] = Model.Recipe.Title;
}

@if (TempData["ImageCleanupWarning"] is string warning)
{
    <div class="alert alert-warning" role="status">@warning</div>
}

<article class="recipe-sheet">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
        <div>
            <a asp-page="Index" class="text-decoration-none">&larr; My recipes</a>
            <h1 class="mt-2">@Model.Recipe.Title</h1>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary" asp-page="Layout" asp-route-id="@Model.Recipe.Id">Customize layout</a>
            <a class="btn btn-outline-secondary" asp-page="Share" asp-route-id="@Model.Recipe.Id">Share</a>
            <a class="btn btn-outline-primary" asp-page="Edit" asp-route-id="@Model.Recipe.Id">Edit</a>
            <a class="btn btn-outline-danger" asp-page="Delete" asp-route-id="@Model.Recipe.Id">Delete</a>
        </div>
    </div>

    <partial name="_RecipeContent" model="Model.Presentation" />
</article>
