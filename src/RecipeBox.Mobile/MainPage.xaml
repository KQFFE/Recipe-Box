<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RecipeBox.Mobile.MainPage"
             Title="Recipe Box">
    <ScrollView x:Name="PageScrollView">
        <VerticalStackLayout Padding="24" Spacing="16">
            <Label
                Text="Recipe Box"
                Style="{StaticResource Headline}"
                SemanticProperties.HeadingLevel="Level1" />

            <Label
                Text="Your recipes are stored on this device. Save to Profile to sync them across devices."
                LineBreakMode="WordWrap" />

            <Label
                x:Name="StatusLabel"
                Text="Add a recipe to get started."
                LineBreakMode="WordWrap" />

            <VerticalStackLayout
                x:Name="RecipesSection"
                Spacing="16">

                <HorizontalStackLayout Spacing="12">
                    <Label
                        Text="My recipes"
                        Style="{StaticResource SubHeadline}"
                        VerticalOptions="Center"
                        SemanticProperties.HeadingLevel="Level2" />
                    <Button
                        x:Name="SaveToProfileButton"
                        Text="Save to Profile"
                        Clicked="OnSaveToProfileClicked"
                        SemanticProperties.Description="Save and sync recipes to your profile" />
                    <Button
                        x:Name="SignOutButton"
                        Text="Sign out"
                        IsVisible="False"
                        Clicked="OnSignOutClicked" />
                    <Button
                        x:Name="ChangeServerButton"
                        Text="Change dev server"
                        IsVisible="False"
                        Clicked="OnChangeServerClicked" />
                </HorizontalStackLayout>

                <Button
                    x:Name="RefreshButton"
                    Text="Refresh recipes"
                    Clicked="OnRefreshClicked" />

                <VerticalStackLayout
                    x:Name="RecipeList"
                    Spacing="10" />

                <BoxView HeightRequest="1" Color="{StaticResource Gray200}" />

                <Label
                    x:Name="RecipeFormHeading"
                    Text="Add a recipe"
                    Style="{StaticResource SubHeadline}"
                    SemanticProperties.HeadingLevel="Level2" />

                <Button
                    x:Name="CapturePhotoButton"
                    Text="Capture recipe photo"
                    Clicked="OnCapturePhotoClicked" />
                <Entry
                    x:Name="ImportUrlEntry"
                    Placeholder="Paste a public recipe page URL"
                    Keyboard="Url"
                    ClearButtonVisibility="WhileEditing" />
                <Button
                    x:Name="ImportUrlButton"
                    Text="Import recipe page"
                    Clicked="OnImportUrlClicked" />
                <Label
                    Text="Photo capture and recipe-page import require a profile and an internet connection."
                    LineBreakMode="WordWrap" />

                <Image
                    x:Name="CoverImage"
                    HeightRequest="180"
                    Aspect="AspectFill"
                    IsVisible="False"
                    SemanticProperties.Description="Recipe cover image" />
                <Button
                    x:Name="ChooseCoverImageButton"
                    Text="Choose cover image"
                    IsVisible="False"
                    Clicked="OnChooseCoverImageClicked" />
                <Button
                    x:Name="RemoveCoverImageButton"
                    Text="Remove cover image"
                    IsVisible="False"
                    Clicked="OnRemoveCoverImageClicked" />

                <Entry
                    x:Name="TitleEntry"
                    Placeholder="Recipe title"
                    MaxLength="160"
                    ReturnType="Next" />
                <Entry
                    x:Name="DescriptionEntry"
                    Placeholder="Description (optional)"
                    MaxLength="2000"
                    ReturnType="Next" />
                <Picker
                    x:Name="LanguagePicker"
                    Title="Recipe language">
                    <Picker.Items>
                        <x:String>English</x:String>
                        <x:String>Swedish</x:String>
                    </Picker.Items>
                </Picker>
                <Editor
                    x:Name="IngredientsEditor"
                    Placeholder="Ingredients, one per line"
                    AutoSize="TextChanges"
                    MinimumHeightRequest="90" />
                <Editor
                    x:Name="InstructionsEditor"
                    Placeholder="Instructions, one per line"
                    AutoSize="TextChanges"
                    MinimumHeightRequest="90" />
                <Button
                    x:Name="CreateButton"
                    Text="Save recipe"
                    Clicked="OnCreateClicked" />
                <Button
                    x:Name="CancelEditButton"
                    Text="Cancel editing"
                    IsVisible="False"
                    Clicked="OnCancelEditClicked" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
