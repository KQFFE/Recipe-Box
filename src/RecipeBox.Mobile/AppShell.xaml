<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="RecipeBox.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:RecipeBox.Mobile"
    Title="Recipe Box">

    <TabBar>
        <ShellContent Title="Home" ContentTemplate="{DataTemplate local:HomePage}" Route="home" />
        <ShellContent Title="My recipes" ContentTemplate="{DataTemplate local:RecipesPage}" Route="recipes" />
        <ShellContent Title="Capture" ContentTemplate="{DataTemplate local:CapturePage}" Route="capture" />
        <ShellContent Title="Import" ContentTemplate="{DataTemplate local:ImportPage}" Route="import" />
        <ShellContent Title="Account" ContentTemplate="{DataTemplate local:AccountPage}" Route="account" />
    </TabBar>

</Shell>
