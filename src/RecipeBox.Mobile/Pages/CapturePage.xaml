<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RecipeBox.Mobile.CapturePage"
             Title="Capture recipe">
    <ScrollView>
        <VerticalStackLayout Padding="20,24" Spacing="16">
            <VerticalStackLayout Spacing="2">
                <Label Text="From a photo" Style="{StaticResource Eyebrow}" />
                <Label Text="Capture recipe" Style="{StaticResource PageTitle}" />
            </VerticalStackLayout>
            <Label Text="Photograph a recipe and review the extracted text before saving it."
                   Style="{StaticResource LeadLabel}" />

            <Border x:Name="StatusBorder" Style="{StaticResource Alert}" IsVisible="False">
                <Label x:Name="StatusLabel"
                       TextColor="{StaticResource BsWarningText}"
                       LineBreakMode="WordWrap" />
            </Border>

            <Border x:Name="AccountPanel" Style="{StaticResource Panel}" IsVisible="False">
                <VerticalStackLayout Spacing="10">
                    <Label Text="An account is needed here" Style="{StaticResource CardTitle}" />
                    <Label Text="Reading a recipe from a photo happens on the server, so it needs an account and an internet connection. Everything else works without one."
                           Style="{StaticResource MutedLabel}" />
                    <Button Text="Sign in or create an account" Clicked="OnAccountClicked" />
                </VerticalStackLayout>
            </Border>

            <Button x:Name="CaptureButton" Text="Take a photo" Clicked="OnCaptureClicked" />
            <Button x:Name="ChooseButton"
                    Text="Choose a photo"
                    Style="{StaticResource OutlinePrimaryButton}"
                    Clicked="OnChooseClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
