<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RecipeBox.Mobile.RecipeFormPage"
             Title="Add a recipe">
    <ScrollView x:Name="PageScrollView">
        <VerticalStackLayout Padding="20,24" Spacing="16">
            <VerticalStackLayout Spacing="2">
                <Label x:Name="EyebrowLabel" Text="New recipe" Style="{StaticResource Eyebrow}" />
                <Label x:Name="HeadingLabel" Text="Add a recipe" Style="{StaticResource PageTitle}" />
            </VerticalStackLayout>

            <Border x:Name="StatusBorder" Style="{StaticResource Alert}" IsVisible="False">
                <Label x:Name="StatusLabel"
                       TextColor="{StaticResource BsWarningText}"
                       LineBreakMode="WordWrap" />
            </Border>

            <VerticalStackLayout Spacing="4">
                <Label Text="Title" Style="{StaticResource FieldLabel}" />
                <Entry x:Name="TitleEntry" MaxLength="160" ReturnType="Next" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label Text="Language" Style="{StaticResource FieldLabel}" />
                <Picker x:Name="LanguagePicker"
                        SelectedIndexChanged="OnLanguageChanged"
                        SemanticProperties.Description="Recipe language" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label Text="Description" Style="{StaticResource FieldLabel}" />
                <Editor x:Name="DescriptionEditor"
                        MaxLength="2000"
                        AutoSize="TextChanges"
                        MinimumHeightRequest="70" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6">
                <Label Text="Cover image" Style="{StaticResource FieldLabel}" />
                <Image x:Name="CoverImage"
                       HeightRequest="180"
                       Aspect="AspectFill"
                       IsVisible="False"
                       SemanticProperties.Description="Recipe cover image" />
                <HorizontalStackLayout Spacing="10">
                    <Button x:Name="ChooseCoverImageButton"
                            Text="Choose image"
                            Style="{StaticResource OutlinePrimaryButton}"
                            Clicked="OnChooseCoverImageClicked" />
                    <Button x:Name="RemoveCoverImageButton"
                            Text="Remove image"
                            Style="{StaticResource OutlineDangerButton}"
                            IsVisible="False"
                            Clicked="OnRemoveCoverImageClicked" />
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label x:Name="IngredientsLabel" Text="Ingredients" Style="{StaticResource FieldLabel}" />
                <Editor x:Name="IngredientsEditor"
                        AutoSize="TextChanges"
                        MinimumHeightRequest="120" />
                <Label x:Name="IngredientsHint" Style="{StaticResource MutedLabel}" FontSize="12" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="4">
                <Label x:Name="InstructionsLabel" Text="Instructions" Style="{StaticResource FieldLabel}" />
                <Editor x:Name="InstructionsEditor"
                        AutoSize="TextChanges"
                        MinimumHeightRequest="150" />
                <Label x:Name="InstructionsHint" Style="{StaticResource MutedLabel}" FontSize="12" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="10">
                <Button x:Name="SaveButton" Text="Save recipe" Clicked="OnSaveClicked" />
                <Button x:Name="CancelButton"
                        Text="Cancel"
                        Style="{StaticResource OutlineSecondaryButton}"
                        Clicked="OnCancelClicked" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
