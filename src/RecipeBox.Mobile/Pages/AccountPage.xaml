<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RecipeBox.Mobile.AccountPage"
             Title="Account">
    <ScrollView>
        <VerticalStackLayout Padding="20,24" Spacing="16">
            <VerticalStackLayout Spacing="2">
                <Label Text="Your profile" Style="{StaticResource Eyebrow}" />
                <Label Text="Account" Style="{StaticResource PageTitle}" />
            </VerticalStackLayout>

            <Border x:Name="StatusBorder" Style="{StaticResource Alert}" IsVisible="False">
                <Label x:Name="StatusLabel"
                       TextColor="{StaticResource BsWarningText}"
                       LineBreakMode="WordWrap" />
            </Border>

            <Label x:Name="SummaryLabel" Style="{StaticResource LeadLabel}" />

            <VerticalStackLayout x:Name="DevServerSection" Spacing="4" IsVisible="False">
                <Label Text="Development server address" Style="{StaticResource FieldLabel}" />
                <Entry x:Name="ServerEntry"
                       Keyboard="Url"
                       Placeholder="https://your-tunnel.trycloudflare.com" />
                <Label Text="Debug builds only. Enter the HTTPS tunnel address, not a command and not localhost."
                       Style="{StaticResource MutedLabel}"
                       FontSize="12" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="10">
                <Button x:Name="SignInButton"
                        Text="Sign in or create an account"
                        Clicked="OnSignInClicked" />
                <Button x:Name="SyncButton"
                        Text="Sync now"
                        Clicked="OnSyncClicked" />
                <Button x:Name="SignOutButton"
                        Text="Sign out"
                        Style="{StaticResource OutlineDangerButton}"
                        Clicked="OnSignOutClicked" />
                <Button x:Name="ChangeServerButton"
                        Text="Change development server"
                        Style="{StaticResource OutlineSecondaryButton}"
                        IsVisible="False"
                        Clicked="OnChangeServerClicked" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
