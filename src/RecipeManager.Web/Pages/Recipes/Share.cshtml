@page "{id:int}"
@model RecipeManager.Web.Pages.Recipes.ShareModel
@{
    ViewData["Title"] = "Share recipe";
}

<div class="recipe-form">
    <a asp-page="Details" asp-route-id="@Model.Recipe.Id" class="text-decoration-none">&larr; Back to recipe</a>
    <h1 class="mt-2">Share @Model.Recipe.Title</h1>
    <p class="text-secondary">
        Anyone with the link can view this recipe using your saved layout. They cannot edit it.
        The link stays active until you revoke or replace it.
    </p>

    @if (Model.StatusMessage is not null)
    {
        <div class="alert alert-success" role="status">@Model.StatusMessage</div>
    }

    @if (Model.ShareUrl is not null)
    {
        <label class="form-label" for="share-link">Share link (copy and save it now)</label>
        <input id="share-link" class="form-control mb-3" value="@Model.ShareUrl" readonly />
        <a class="btn btn-outline-primary mb-3" href="@Model.ShareUrl">Open shared recipe</a>
    }

    <form method="post" class="d-flex flex-wrap gap-2">
        @if (Model.HasActiveShare)
        {
            <button type="submit" class="btn btn-primary" asp-page-handler="Create">
                Create a new link
            </button>
            <button type="submit" class="btn btn-outline-danger" asp-page-handler="Revoke">
                Revoke current link
            </button>
        }
        else
        {
            <button type="submit" class="btn btn-primary" asp-page-handler="Create">Create share link</button>
        }
        <a class="btn btn-outline-secondary" asp-page="Details" asp-route-id="@Model.Recipe.Id">Cancel</a>
    </form>
</div>
