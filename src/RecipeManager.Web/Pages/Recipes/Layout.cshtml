@page "{id:int}"
@model RecipeManager.Web.Pages.Recipes.LayoutModel
@{
    ViewData["Title"] = "Customize recipe layout";
}

<div class="recipe-form">
    <a asp-page="Details" asp-route-id="@Model.Recipe.Id" class="text-decoration-none">&larr; Back to recipe</a>
    <h1 class="mt-2">Customize layout</h1>
    <p class="text-secondary">
        Arrange the sections and choose which ones use the full width. These settings apply only to this recipe in your account.
    </p>

    <form method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <ol class="list-group mb-4" aria-label="Recipe section order">
            @for (var index = 0; index < Model.SectionOrder.Count; index++)
            {
                var key = Model.SectionOrder[index];
                var layoutSection = Model.AvailableSections.Single(item => item.Key == key);
                <li class="list-group-item layout-section-item">
                    <input type="hidden" name="SectionOrder" value="@key" />
                    <span class="fw-semibold">@layoutSection.Label</span>
                    <div class="d-flex flex-wrap gap-2">
                        <label class="form-check mb-0">
                            <input class="form-check-input" type="checkbox"
                                   name="FullWidthSections" value="@key"
                                   checked="@Model.FullWidthSections?.Contains(key)" />
                            <span class="form-check-label">Full width</span>
                        </label>
                        <button type="submit" class="btn btn-sm btn-outline-secondary"
                                asp-page-handler="MoveUp" asp-route-index="@index"
                                disabled="@(index == 0)" aria-label="Move @layoutSection.Label up">
                            Move up
                        </button>
                        <button type="submit" class="btn btn-sm btn-outline-secondary"
                                asp-page-handler="MoveDown" asp-route-index="@index"
                                disabled="@(index == Model.SectionOrder.Count - 1)" aria-label="Move @layoutSection.Label down">
                            Move down
                        </button>
                    </div>
                </li>
            }
        </ol>
        <button type="submit" class="btn btn-primary" asp-page-handler="Save">Save layout</button>
        <a class="btn btn-outline-secondary" asp-page="Details" asp-route-id="@Model.Recipe.Id">Cancel</a>
    </form>
</div>
